{
  "name": "@vancityayush/tui",
  "version": "0.1.0",
  "description": "Rich React+Yoga terminal UI engine extracted from Claude Code: synchronized output, alt-screen, hyperlinks, focus manager, selection/copy, theming, keybindings, vim-mode input.",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "native", "README.md"],
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.0",
    "auto-bind": "^5.0.1",
    "bidi-js": "1.0.3",
    "chalk": "^5.3.0",
    "chokidar": "5.0.0",
    "cli-boxes": "4.0.1",
    "code-excerpt": "4.0.0",
    "emoji-regex": "10.6.0",
    "execa": "9.6.1",
    "figures": "6.1.0",
    "get-east-asian-width": "1.5.0",
    "indent-string": "5.0.0",
    "lodash-es": "^4.17.21",
    "react-reconciler": "^0.31.0",
    "semver": "7.7.4",
    "signal-exit": "^4.1.0",
    "stack-utils": "2.0.6",
    "strip-ansi": "7.2.0",
    "supports-hyperlinks": "4.4.0",
    "type-fest": "5.6.0",
    "usehooks-ts": "3.1.1",
    "wrap-ansi": "10.0.0",
    "zod": "4.3.6"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build ./src/index.ts --target=bun --outdir=dist --format=esm --external react --external react-reconciler --external react/jsx-runtime --external react/compiler-runtime",
    "example:minimal": "bun run examples/minimal.tsx",
    "example:themed": "bun run examples/themed.tsx",
    "example:keybindings": "bun run examples/keybindings.tsx"
  },
  "keywords": ["tui", "terminal", "ink", "react", "cli", "yoga", "bun"],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/react": "19.2.14",
    "@types/react-reconciler": "0.33.0"
  }
}
